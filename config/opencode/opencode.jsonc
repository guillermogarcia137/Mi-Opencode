{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-pro",
  "small_model": "opencode/deepseek-v4.1-flash-free",
  "agents": {
    "build": {
      "model": "opencode/deepseek-v4-pro"
    },
    "explore": {
      "model": "opencode/deepseek-v4-pro"
    },
    "general": {
      "model": "opencode/deepseek-v4-pro"
    },
    "plan": {
      "model": "opencode/deepseek-v4-pro"
    }
  },
  "tool_output": {
    "max_lines": 150,
    "max_bytes": 32768
  },
  "mcp": {
    "servers": {
      "memory": {
        "type": "local",
        "command": [
          "E:/Programas/nodejs/node.exe",
          "C:/Users/Alumno/AppData/Roaming/npm/node_modules/@modelcontextprotocol/server-memory/dist/index.js"
        ],
        "environment": {
          "MEMORY_FILE_PATH": "E:/Programas/opencode/data/opencode/memory.jsonl"
        }
      }
    }
  }
}
